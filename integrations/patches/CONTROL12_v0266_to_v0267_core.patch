+    def apply_settlement(db, ident, task_id, data, outcome):
+        """Serializes acknowledgement replay with the original ledger mutation."""
+        t = get_task(db, ident, task_id, lock=True)
+        if t.status in ("succeeded", "failed"):
+            replay = existing_settlement(db, ident, t.id, data, outcome)
+            if replay is not None:
+                return replay, True
+            raise HTTPException(409, "task already settled; no receipt exists")
