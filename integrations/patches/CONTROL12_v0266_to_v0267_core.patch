+        settlement(db, ident, t, data.actual, outcome,
+                   result=data.result if outcome == "succeeded" else None,
+                   error_code=data.error_code if outcome == "failed" else None)
+        response = task_out(t)
+        save_settlement(db, ident, t, data, outcome, response)
+        return response, False
