+def settlement_payload_digest(data, outcome):
+    # Never hash/store lease token as ordinary JSON; bind it separately by SHA-256.
+    data_fields = data.model_dump(mode="json", exclude={"lease_token"})
+    encoded = json.dumps({"outcome": outcome, "data": data_fields}, sort_keys=True,
+                         ensure_ascii=False, separators=(",", ":"), allow_nan=False)
+    return hashlib.sha256(encoded.encode("utf-8")).hexdigest()
+
+
+def existing_settlement(db, ident, task_id, data, outcome):
+    """Only a byte-identical lease owner and canonical payload may replay."""
+    row = db.scalar(select(SettlementReceipt).where(
+        SettlementReceipt.tenant == ident.tenant,
+        SettlementReceipt.task_id == task_id).with_for_update())
+    if row is None:
+        return None
+    candidate = hashlib.sha256(data.lease_token.encode("utf-8")).hexdigest()
+    digest = settlement_payload_digest(data, outcome)
+    if (row.principal != ident.principal or
+            not hmac.compare_digest(row.lease_hash, candidate) or
+            row.outcome != outcome or
+            not hmac.compare_digest(row.payload_sha256, digest)):
+        raise HTTPException(409, "task settlement conflict")
+    return row.response_payload
+
+
+def save_settlement(db, ident, t, data, outcome, response):
+    db.add(SettlementReceipt(id=uid(), tenant=ident.tenant, principal=ident.principal,
+                             task_id=t.id, lease_hash=hashlib.sha256(data.lease_token.encode()).hexdigest(),
+                             outcome=outcome, payload_sha256=settlement_payload_digest(data, outcome),
+                             response_payload=response))
+    db.flush()
+
